{
  "name": "@voyager-crew/cli",
  "version": "0.5.1",
  "description": "Ask ChatGPT from your terminal or your coding agent, through the Voyager browser extension",
  "keywords": [
    "chatgpt",
    "cli",
    "agent",
    "voyager",
    "browser-extension"
  ],
  "homepage": "https://github.com/voyager-crew/voyager-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voyager-crew/voyager-cli.git"
  },
  "bugs": {
    "url": "https://github.com/voyager-crew/voyager-cli/issues"
  },
  "license": "MIT",
  "author": "Jesse Zhang",
  "type": "module",
  "bin": {
    "voyager": "dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs",
    "skills",
    "README.md",
    "README_ZH.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "bun build.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "verify": "bun run format:check && bun run lint:check && bun run typecheck && bun run test",
    "prepublishOnly": "bun run verify && bun run build",
    "prepare": "node scripts/install-git-hooks.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@voyager-crew/bridge-protocol": "^0.5.0",
    "fflate": "0.8.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
